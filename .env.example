# Criterivox environment configuration
# Never place real secrets in this file.

CRITERIVOX_ENVIRONMENT=development
# Local character intelligence. start-criterivox.ps1 provisions Ollama and the configured model automatically.
CRITERIVOX_LLM_PROVIDER=local
CRITERIVOX_OPENAI_MODEL=gpt-5.6-luna
# Set this only when using a local Ollama-compatible model runtime.
CRITERIVOX_LOCAL_LLM_URL=http://127.0.0.1:11434/api/chat
CRITERIVOX_LOCAL_LLM_MODEL=llama3.2:3b
OPENAI_API_KEY=

# Google account OAuth

# Google Programmable Search API, separate from Google account OAuth
CRITERIVOX_GOOGLE_API_KEY=
CRITERIVOX_GOOGLE_CX=
CRITERIVOX_EXTERNAL_RESEARCH_PROVIDER=google
