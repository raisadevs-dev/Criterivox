# Criterivox environment configuration
# Never place real secrets in this file.

CRITERIVOX_ENVIRONMENT=development
# Research collection is OFF by default. Enable only for an approved study.
CRITERIVOX_RESEARCH_ENABLED=false
# Local research database path; production can point the repository adapter at remote storage.
CRITERIVOX_RESEARCH_DB=data/research/criterivox_research.sqlite3
# Required to access researcher summary/session/event/export endpoints.
CRITERIVOX_RESEARCH_ADMIN_TOKEN=replace-with-local-secret
