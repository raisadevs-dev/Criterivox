# Criterivox environment configuration
# Never place real secrets in this file.

CRITERIVOX_ENVIRONMENT=development

# Comma-separated exact origins. For hosted deployment, set the exact
# HTTPS origin of the frontend in the hosting provider's environment UI.
CRITERIVOX_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
